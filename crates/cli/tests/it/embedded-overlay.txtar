Test-only overlay of the testsite (REWRITE_PLAN.md §7.1, T60): content, configuration and
layouts that call every embedded template. Written over the testsite by tests/it/embedded.rs,
which also writes the PNG files, the getresource cache entries of the x and vimeo oEmbed
requests, and the markup settings into config.toml (codeFences, block attributes, standalone
images), and config/_default/privacy.toml per variant.
The shared testsite, and so Go's reference build, stays as it is.
-- config/_default/params.toml --
description = "Site <b>description</b> & more"
images = ["/img/site.png"]
[social]
twitter = "example"
facebook_app_id = "12345"
-- config/_default/services.toml --
[googleAnalytics]
id = "G-ABC123"
-- config/_default/caches.toml --
[getresource]
dir = ":resourceDir/_gen"
maxAge = -1
-- config/_default/taxonomies.toml --
tag = "tags"
category = "categories"
series = "series"
-- layouts/embedded/single.html --
<head>
{% include "_partials/opengraph.html" %}
{% include "_partials/twitter_cards.html" %}
{% include "_partials/schema.html" %}
{% include "_partials/google_analytics.html" %}
</head>
<main>{{ page.content }}</main>
-- layouts/embedded/list.html --
<head>
{% include "_partials/opengraph.html" %}
{% include "_partials/twitter_cards.html" %}
{% include "_partials/schema.html" %}
</head>
<main>{% set pager = paginator() %}{% for p in pager.pages %}{{ p.title }};{% endfor %}</main>
<nav>
{% include "_partials/pagination.html" %}
</nav>
<nav>
{{ partial(name="pagination", format="terse") }}
</nav>
