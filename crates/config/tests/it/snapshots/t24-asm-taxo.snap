---
source: crates/config/tests/it/sites.rs
expression: summary(&c)
---
content:
  drafts: false
  expired: false
  future: false
defaultLanguageInSubdir: false
environment: production
formats:
  - html
  - "404"
  - alias
  - amp
  - calendar
  - css
  - csv
  - gotmpl
  - json
  - markdown
  - robots
  - rss
  - sitemap
  - sitemapindex
  - webappmanifest
minifyOutput: false
multihost: false
security:
  inlineShortcodes: disabled
sites:
  - baseURL: "https://example.org/sub/"
    cascade: 0
    code: en
    disableKinds: []
    lang: en
    mainSections: ~
    menus: 0
    name: ""
    outputs:
      "404":
        - "404"
      home:
        - html
        - rss
      page:
        - html
      robotstxt:
        - robots
      section:
        - html
        - rss
      sitemap:
        - sitemap
      sitemapindex:
        - sitemapindex
      taxonomy:
        - html
        - rss
      term:
        - html
        - rss
    pagination:
      disableAliases: false
      pagerSize: 10
      path: page
    params: 0
    permalinks:
      page:
        docs: "/:sections/:filename/"
        news: "/:section/:contentbasename/"
        posts: "/:year/:month/:slug/"
      section:
        posts: /articles/
      taxonomy:
        tags: /topics/
      term:
        categories: "/cat/:title/"
        posts: "/:year/:month/:slug/"
        tags: "/topic/:slug/"
    taxonomies:
      - category=categories
      - series=series
      - tag=tags
    timeZone: UTC
    title: Asm Taxo
    ugly:
      sections:
        news: true
    urlPrefix: ""
    weight: 0
timeout: 60
